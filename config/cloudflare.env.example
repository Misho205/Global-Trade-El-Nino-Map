# Copy values to your shell or ignored local environment file; this file contains no secrets.
# Never reuse staging resources in production. Replace the ID after creating D1.
ATLAS_ENVIRONMENT=staging
ATLAS_DEPLOY_TARGET=cloudflare
ATLAS_WORKER_NAME=global-trade-el-nino-map-staging
CLOUDFLARE_D1_DATABASE_NAME=global-trade-data-staging
CLOUDFLARE_D1_DATABASE_ID=REPLACE_WITH_REAL_D1_UUID
ATLAS_ENABLE_CRON=true
# Runtime secrets are set separately with Wrangler/dashboard; do not put them here.
# BILLING_ENABLED and PRO_FEATURES_VALIDATED remain off until validated.

# Optional async billing STAGING BUILD settings; requires actual queues and migration 0005.
# BILLING_ASYNC_ENABLED=true
# ATLAS_BILLING_QUEUE=atlas-billing-staging
# ATLAS_BILLING_DLQ=atlas-billing-dead-staging
# Auth0 runtime secrets and ORGANIZATIONS_ENABLED are configured separately.
